{
  "name": "sekirei-todo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "docker compose up --build --watch",
    "dev:remote": "docker compose --env-file .env.remote up --build --watch",
    "dev:remote:logs": "docker compose --env-file .env.remote logs -f",
    "dev:remote:down": "docker compose --env-file .env.remote down",
    "stop": "docker compose stop",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "db:generate": "pnpm --filter database generate",
    "db:migrate": "docker compose exec server-ts pnpm --filter database migrate",
    "db:seed": "docker compose exec server-ts pnpm --filter database seed"
  }
}
