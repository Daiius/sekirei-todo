# リモート dev 公開時にだけ足す環境変数（ローカル dev では不要）。
# この例をコピーして値を埋める:
#   cp .env.remote.example .env.remote   # .env.remote は gitignore 対象
#   pnpm dev:remote
#
# ローカル dev（pnpm dev）はこのファイルを渡さず、compose 既定値で動く。リモート差分は
# すべてこのファイルに集約され、compose.yml / next.config.ts の本体は単一のまま
# （リモート専用の override compose ファイルは持たない）。
#
# 使われ方は `docker compose --env-file .env.remote ...` の interpolation のみ。
# コンテナに入る値は compose.yml の environment: が ${...} 経由で受け取る。

# nextjs をホストに公開するバインド。cloudflared をこのアドレスへ向ける。
# ループバックだけに束縛し、外部 NIC には出さない。
WEB_BIND=127.0.0.1:8080

# 公開ホスト名（スキームなし）。next.config.ts の allowedDevOrigins が有効になる。
# 実ドメインはここに書く（リポジトリには入れない）。
DEV_ALLOWED_HOST=<dev-host>

# ブラウザから見える唯一のオリジン（スキーム込み）。単一ホスト名に畳む構成なので
# Next.js も /api/* 越しの better-auth もすべてこのオリジンに乗る。
# compose がこれを server-ts の BETTER_AUTH_URL と TRUSTED_ORIGINS に配る。
# nextjs 側は自オリジンを見るので NEXT_PUBLIC_* は不要 (単一オリジン化で参照が消えた)。
# ローカル既定は http://localhost:3000。
#
# ⚠ GitHub OAuth App の Authorization callback URL に
#   https://<dev-host>/api/auth/callback/github を登録しておくこと
#   （callback URL は複数登録できるので、ローカル用・本番用と併存させる）。
PUBLIC_ORIGIN=https://<dev-host>
